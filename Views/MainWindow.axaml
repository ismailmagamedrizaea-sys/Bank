    <Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AvaloniaApplication29.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="AvaloniaApplication29.Views.MainWindow"
        Title="AvaloniaApplication29"
        Width="760"
        Height="720"
        MinWidth="560"
        MinHeight="560">

    <ScrollViewer>
        <StackPanel Margin="24" Spacing="16">
            <TextBlock
                FontSize="28"
                FontWeight="Bold"
                Text="Демо-банк" />

            <Border Padding="16" CornerRadius="8" Background="#F0F3F8">
                <StackPanel Spacing="6">
                    <TextBlock Text="Баланс" />
                    <TextBlock
                        FontSize="26"
                        FontWeight="Bold"
                        Text="{Binding BalanceText}" />
                </StackPanel>
            </Border>

            <TextBlock FontSize="20" FontWeight="SemiBold" Text="Покупка" />

            <TextBox
                Watermark="Название покупки"
                Text="{Binding PurchaseTitle}" />

            <TextBox
                Watermark="Сумма"
                Text="{Binding PurchaseAmountText}" />

            <Button
                HorizontalAlignment="Left"
                Content="Оплатить"
                Command="{Binding BuyCommand}" />

            <TextBlock FontSize="20" FontWeight="SemiBold" Text="Перевод" />

            <TextBox
                Watermark="ID счета получателя (например, 2)"
                Text="{Binding RecipientIdText}" />

            <TextBox
                Watermark="Сумма перевода"
                Text="{Binding TransferAmountText}" />

            <Button
                HorizontalAlignment="Left"
                Content="Перевести"
                Command="{Binding TransferCommand}" />

            <TextBlock
                FontSize="20"
                FontWeight="SemiBold"
                Text="История покупок и переводов" />

            <ListBox ItemsSource="{Binding History}" MaxHeight="260">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnDefinitions="*,Auto" Margin="4">
                            <StackPanel Spacing="2">
                                <TextBlock
                                    FontWeight="SemiBold"
                                    Text="{Binding Description}" />
                                <TextBlock
                                    FontSize="12"
                                    Opacity="0.7"
                                    Text="{Binding DateText}" />
                            </StackPanel>

                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Text="{Binding AmountText}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock
                Text="{Binding StatusMessage}"
                TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <StackPanel Margin="40">
        <StackPanel>
            <TextBox PlaceholderText="Login:" Text="{Binding Login}" Margin="0 0 0 10" />
            <TextBox PlaceholderText="Email:" Text="{Binding Email}" Margin="0 0 0 10" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Add" Command="{Binding AddUserCommand}" HorizontalAlignment="Center" />
                <Button Content="Remove" Command="{Binding DeleteUserCommand}" HorizontalAlignment="Center" />
            </StackPanel>
        </StackPanel>

        <TextBlock Text="Users:" FontSize="30" FontWeight="Bold" />
        <ScrollViewer>
            <ListBox ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Login}" />
                            <TextBlock Text="{Binding Email}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </ScrollViewer>

    </StackPanel>
</Window>
